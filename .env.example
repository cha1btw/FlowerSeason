TELEGRAM_BOT_TOKEN=replace_with_bot_token
TELEGRAM_CHAT_ID=replace_with_chat_id
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Online booking (/workshops)
DATABASE_URL=
# Merchant token from monobank acquiring (test token works without a contract)
MONOBANK_TOKEN=
# Resend (https://resend.com) for confirmation and reminder emails
RESEND_API_KEY=
EMAIL_FROM=
# Comma-separated Telegram user ids allowed to use the admin bot
ADMIN_TELEGRAM_IDS=
# Random string; Telegram sends it back so only Telegram can call the bot webhook
TELEGRAM_WEBHOOK_SECRET=
# Random string; Vercel Cron sends it so only Vercel can trigger reminders
CRON_SECRET=
